# CIVIORA Backend Environment Variables
# Copy this file to .env for local backend development

# Database Connection (SQLite by default, PostgreSQL/Supabase for production)
# Example PostgreSQL: postgresql://postgres:password@db.example.supabase.co:5432/postgres
DATABASE_URL=sqlite:///civiora.db

# Secret key for JWT Token Signing
JWT_SECRET=your-production-jwt-secret-key-change-this

# CORS Allowed Origins (Comma-separated URLs)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://civiora.vercel.app

# Optional AI / LLM API Key (if external model service is configured)
AI_API_KEY=

# Server Port (Injected automatically by Render/Koyeb/Railway)
PORT=8000
